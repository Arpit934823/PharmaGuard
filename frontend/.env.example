# ──────────────────────────────────────────────
# Frontend env vars (create a .env file in frontend/ to set these)
# ──────────────────────────────────────────────

# Optional: Override the API base URL.
# Leave empty (or unset) to use same-origin /api/* (production default on Netlify).
# Set to your local backend URL during dev if NOT using Vite's built-in proxy.
# Example: VITE_API_URL=http://localhost:3001
VITE_API_URL=
